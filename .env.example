# Copy this to .env and fill in your values

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=smart_study_planner

# JWT Secret - use a long random string in production!
JWT_SECRET=change_this_to_a_long_random_secret_string

# Optional: create an admin on a NEW database. Existing accounts are not reset.
# Supply both values; use a unique password with at least 12 characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Express port for local development (Docker uses 4000 inside the backend)
PORT=4000

# Docker host ports
FRONTEND_PORT=3000
BACKEND_PORT=9001

# For Vercel frontend deployment only (when deploying frontend separately)
# VITE_API_URL=https://your-app.railway.app/api
