# Copy this to .env and fill in your values

# Database (PostgreSQL). One server; each service creates and uses its own
# database (auth_db, task_db, quiz_db) on first start.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
# Database the Docker PostgreSQL container creates first (and the old
# single-backend database that scripts/migrate-to-microservices.sh reads)
DB_NAME=smart_study_planner

# JWT Secret shared by all four services - use a long random string!
# Every service refuses to start without it.
JWT_SECRET=change_this_to_a_long_random_secret_string

# Optional: create an admin on a NEW database. Existing accounts are not reset.
# Supply both values; use a unique password with at least 12 characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Local development ports are set by `npm run server`: auth 4001, task 4002,
# quiz 4003, progress 4004. In Docker every service listens on 4000 inside
# its own container.

# Docker host port: the gateway (nginx) is the only published port
FRONTEND_PORT=3000

# For Vercel frontend deployment only (when deploying frontend separately)
# VITE_API_URL=https://your-app.railway.app/api
