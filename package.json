{
  "name": "smart-study-planner",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Smart Study Planner web app (React + Express microservices + PostgreSQL) — SRS implementation",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "concurrently -n auth,task,quiz,progress,ai -c blue,green,yellow,magenta,cyan \"npm:service:*\"",
    "service:auth": "PORT=4001 node services/auth-service/index.js",
    "service:task": "PORT=4002 node services/task-service/index.js",
    "service:quiz": "PORT=4003 node services/quiz-service/index.js",
    "service:progress": "PORT=4004 node services/progress-service/index.js",
    "service:ai": "PORT=4005 node services/ai-service/index.js",
    "start": "npm run server",
    "share": "concurrently \"npm run server\" \"vite\" \"lt --port 5173 --subdomain ssp-web-app\" --handle-input",
    "tunnel": "lt --port 5173 --subdomain ssp-web-app --local-host localhost"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "dotenv": "^18.0.10",
    "express": "^4.19.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.21.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "styled-components": "^6.4.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^10.0.3",
    "localtunnel": "^2.0.2",
    "vite": "^5.4.8"
  }
}
